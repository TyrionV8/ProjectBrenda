; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hardware Defence"
config/description="Tower defense on a circuit board: stop the bugs before they reach the CPU."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.0235, 0.0431, 0.0745, 1)
config/icon="res://icon.svg"

[autoload]

Settings="*res://src/Autoload/Settings.cs"
Audio="*res://src/Autoload/Audio.cs"
Transition="*res://src/Autoload/Transition.cs"
PostFx="*res://src/Autoload/PostFx.cs"
DevTools="*res://src/Autoload/DevTools.cs"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="HardwareDefence"

[gui]

theme/custom="res://assets/ui/theme.tres"
theme/custom_font="res://assets/fonts/ShareTechMono-Regular.ttf"

[input]

pause={
